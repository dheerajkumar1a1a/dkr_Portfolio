        "jsCode": "// 1. Grab the raw output from the AI Agent node (checking common output keys)\nlet rawOutput = $input.first().json.output || $input.first().json.text || $input.first().json;\n\n// 2. If it's already a clean object, just return it directly\nif (typeof rawOutput === 'object' && rawOutput !== null) {\n    return rawOutput;\n}\n\n// 3. Otherwise, clean up stringified JSON (handling \\n, backticks, or extra spaces)\nlet cleanedOutput = rawOutput\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n// 4. Parse the cleaned string into an actual JSON object\nconst parsedJson = JSON.parse(cleanedOutput);\n\n// 5. Output the structured object for the Switch node\nreturn parsedJson;"
